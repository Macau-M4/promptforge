# Copy to `.env` (git-ignored) for local development, or set these as
# secrets/variables in your host's build settings. None of these are secrets
# except where noted — the LLM keys below are always *user-provided* in the
# browser and never baked into the site.

# Canonical public URL — ORIGIN ONLY (no trailing slash, no repo path).
# Used for sitemap, OpenGraph, RSS. The repo path goes in PUBLIC_BASE below.
PUBLIC_SITE=https://YOUR_USERNAME.github.io

# Base path. "/" for a user/org site or custom domain; "/REPO/" for a project site.
PUBLIC_BASE=/

# GitHub OAuth App "Client ID" (PUBLIC — safe to commit). Create one free at
# https://github.com/settings/developers → New OAuth App (enable Device Flow).
# Without it, login shows setup instructions instead.
PUBLIC_GITHUB_CLIENT_ID=

# Repo slug "owner/name" used for "Fork" and "Submit via PR" deep links.
PUBLIC_REPO=YOUR_USERNAME/YOUR_REPO
