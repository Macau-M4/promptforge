---
import '../styles/global.css';

interface Props {
  title?: string;
  description?: string;
}

const {
  title = 'PromptForge',
  description = 'PromptForge — the free, open-source library of AI prompts, commands, tools and workflows. Learn, vote, run and contribute.'
} = Astro.props;

const base = import.meta.env.BASE_URL;
const nav = [
  { href: '', label: 'Browse' },
  { href: 'paths', label: 'Learning paths' },
  { href: 'tools', label: 'Tools' },
  { href: 'run', label: 'Run' },
  { href: 'contribute', label: 'Contribute' }
];
const fullTitle = title === 'PromptForge' ? title : `${title} · PromptForge`;
const logo = `${base}#`;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta name="theme-color" content="#0a0a10" />
    <link rel="icon" type="image/svg+xml" href={`${base}favicon.svg`} />
    <link rel="sitemap" href={`${base}sitemap.xml`} />
  </head>
  <body class="min-h-screen flex flex-col">
    <header class="sticky top-0 z-40 border-b border-white/10 bg-[#0a0a10]/80 backdrop-blur">
      <div class="mx-auto max-w-6xl px-4 sm:px-6 h-16 flex items-center gap-4">
        <a href={logo} class="flex items-center gap-2 font-bold text-lg tracking-tight shrink-0">
          <span class="grid place-items-center w-8 h-8 rounded-lg bg-gradient-to-br from-indigo-500 to-violet-500 text-white">⚒️</span>
          <span>Prompt<span class="grad-text">Forge</span></span>
        </a>

        <nav class="hidden md:flex items-center gap-1 text-sm text-slate-300">
          {nav.map((n) => (
            <a
              href={`${base}${n.href}`}
              class="px-3 py-2 rounded-lg hover:bg-white/5 hover:text-white transition-colors"
              aria-current={Astro.url.pathname.replace(base, '') === n.href || (n.href === '' && Astro.url.pathname.replace(base, '') === '') ? 'page' : undefined}
            >
              {n.label}
            </a>
          ))}
        </nav>

        <div class="ml-auto flex items-center gap-2">
          <div id="auth-widget"></div>
          <details class="md:hidden relative">
            <summary class="list-none btn-ghost px-3 py-2 cursor-pointer select-none">☰</summary>
            <div class="absolute right-0 mt-2 w-48 panel p-2 flex flex-col gap-1">
              {nav.map((n) => (
                <a href={`${base}${n.href}`} class="px-3 py-2 rounded-lg hover:bg-white/5 text-sm text-slate-200">{n.label}</a>
              ))}
            </div>
          </details>
        </div>
      </div>
    </header>

    <main class="flex-1"><slot /></main>

    <footer class="border-t border-white/10 mt-16">
      <div class="mx-auto max-w-6xl px-4 sm:px-6 py-10 grid gap-8 sm:grid-cols-3 text-sm text-slate-400">
        <div>
          <p class="font-semibold text-slate-200 mb-2">PromptForge</p>
          <p class="leading-relaxed">A free, open-source library of AI prompts, commands, tools and workflows — built and maintained by the community.</p>
        </div>
        <div>
          <p class="font-semibold text-slate-200 mb-2">Explore</p>
          <ul class="space-y-1.5">
            {nav.map((n) => (
              <li><a href={`${base}${n.href}`} class="hover:text-white">{n.label}</a></li>
            ))}
            <li><a href={`${base}about`} class="hover:text-white">About</a></li>
          </ul>
        </div>
        <div>
          <p class="font-semibold text-slate-200 mb-2">100% free</p>
          <ul class="space-y-1.5">
            <li>Static site · no server costs</li>
            <li>Keyless LLM via Pollinations</li>
            <li>GitHub OAuth login</li>
            <li>MIT-licensed content</li>
          </ul>
        </div>
      </div>
      <div class="border-t border-white/10 py-4 text-center text-xs text-slate-500">
        Built with Astro + Tailwind · Deployed free on GitHub Pages · Zero recurring cost
      </div>
    </footer>

    <script>
      import { initAuth } from '../scripts/auth';
      initAuth();
    </script>
  </body>
</html>
