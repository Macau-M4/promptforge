---
import '../styles/global.css';

interface Props {
  title?: string;
  description?: string;
}

const {
  title = 'PromptForge',
  description = 'PromptForge — the free, open-source library of AI prompts, commands, tools and workflows. Learn, vote, run and contribute.'
} = Astro.props;

const base = import.meta.env.BASE_URL;
const nav = [
  { href: '', label: 'Browse' },
  { href: 'paths', label: 'Paths' },
  { href: 'tools', label: 'Tools' },
  { href: 'run', label: 'Playground' },
  { href: 'contribute', label: 'Contribute' }
];
// Normalized current path (strip base + any trailing slash) so nav highlighting
// works on `/paths/`, `/tools/`, `/run/`, `/contribute/` and not just `/`.
const currentPath = (Astro.url.pathname.replace(base, '') || '').replace(/\/+$/, '');
const fullTitle = title === 'PromptForge' ? title : `${title} · PromptForge`;
const logo = `${base}#`;
const marquee = ['PROMPTS', 'TOOLS', 'WORKFLOWS', 'LEARN', 'VOTE', 'RUN', 'FORGE'];
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta name="theme-color" content="#0a0a0b" />
    <link rel="icon" type="image/svg+xml" href={`${base}favicon.svg`} />
    <link rel="sitemap" href={`${base}sitemap.xml`} />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&family=Space+Grotesk:wght@400;500;600;700&family=JetBrains+Mono:wght@400;500&family=Noto+Sans+Thai:wght@400;500;600&display=swap"
      rel="stylesheet"
    />
    <noscript>
      <style>
        [data-reveal], .kinetic-line > span { opacity: 1 !important; transform: none !important; }
        #preloader { display: none !important; }
      </style>
    </noscript>
  </head>
  <body class="min-h-screen flex flex-col bg-[#0a0a0b]">
    <div id="preloader" aria-hidden="true">
      <div class="preloader-inner">
        <span class="preloader-mark">P</span>
        <span class="preloader-bar"><span class="preloader-bar-fill"></span></span>
      </div>
    </div>
    <div id="page-transition" aria-hidden="true">
      <div class="pt-circle"></div>
      <div class="pt-brand">
        <div class="pt-inner">
          <span class="pt-mark">P</span>
          <span class="pt-bar"><span class="pt-bar-fill"></span></span>
        </div>
      </div>
    </div>
    <div id="scroll-progress" class="fixed top-0 left-0 z-50 h-[2px] w-0 bg-zinc-100" aria-hidden="true"></div>
    <div id="cursor-glow" aria-hidden="true"></div>

    <header class="sticky top-0 z-40 border-b border-[#1c1c20] bg-[#0a0a0b]/85 backdrop-blur">
      <div class="mx-auto max-w-6xl px-5 sm:px-6 h-16 flex items-center gap-6">
        <a href={logo} class="flex items-center gap-2.5 shrink-0">
          <span class="grid place-items-center w-7 h-7 border border-zinc-500 text-zinc-100 font-display font-bold text-sm">P</span>
          <span class="font-display font-semibold text-lg tracking-tight text-zinc-100">Prompt<span class="silver-text">Forge</span></span>
        </a>

        <nav id="main-nav" class="hidden md:flex items-center gap-1 text-sm text-zinc-400 relative">
          <span id="nav-indicator" aria-hidden="true"></span>
          {nav.map((n) => {
            const current = currentPath === n.href || (n.href === '' && currentPath === '');
            return (
              <a
                href={`${base}${n.href}`}
                class={`px-3 py-2 transition-colors relative z-10 ${current ? 'text-zinc-100' : 'hover:text-zinc-100'}`}
                aria-current={current ? 'page' : undefined}
              >
                {n.label}
              </a>
            );
          })}
        </nav>

        <div class="ml-auto flex items-center gap-3">
          <div id="auth-widget"></div>
          <details class="md:hidden relative">
            <summary class="list-none btn-ghost px-3 py-2 cursor-pointer select-none">☰</summary>
            <div class="absolute right-0 mt-2 w-48 panel p-2 flex flex-col gap-1">
              {nav.map((n) => (
                <a href={`${base}${n.href}`} class="px-3 py-2 text-sm text-zinc-200 hover:bg-white/5">{n.label}</a>
              ))}
            </div>
          </details>
        </div>
      </div>
    </header>

    <main class="flex-1"><slot /></main>

    <footer class="border-t border-[#1c1c20] mt-20">
      <div class="marquee py-4 text-zinc-500 font-display font-semibold text-2xl uppercase">
        <div class="marquee-track">
          {[0, 1].map(() => (
            <div class="flex items-center gap-8 pr-8">
              {marquee.map((m) => (
                <span class="flex items-center gap-8">{m}<span class="text-zinc-700">·</span></span>
              ))}
            </div>
          ))}
        </div>
      </div>
      <div class="mx-auto max-w-6xl px-5 sm:px-6 py-12 grid gap-10 sm:grid-cols-3 text-sm text-zinc-500">
        <div>
          <p class="font-display font-semibold text-zinc-200 mb-3">PromptForge</p>
          <p class="leading-relaxed max-w-xs">คลัง Prompt, คำสั่ง และ Workflow แบบ open-source ฟรี — สร้างและดูแลโดย community</p>
        </div>
        <div>
          <p class="mono-label mb-3">Explore</p>
          <ul class="space-y-2">
            {nav.map((n) => (
              <li><a href={`${base}${n.href}`} class="hover:text-zinc-100 transition-colors">{n.label}</a></li>
            ))}
            <li><a href={`${base}about`} class="hover:text-zinc-100 transition-colors">About</a></li>
          </ul>
        </div>
        <div>
          <p class="mono-label mb-3">Principles</p>
          <ul class="space-y-2">
            <li>Static site · ไม่มีค่า server</li>
            <li>Keyless LLM ผ่าน Pollinations</li>
            <li>Login ผ่าน GitHub OAuth</li>
            <li>เนื้อหา MIT license</li>
          </ul>
        </div>
      </div>
      <div class="border-t border-[#1c1c20] py-5 text-center font-mono text-[11px] uppercase tracking-[0.2em] text-zinc-600">
        Astro + Tailwind · GitHub Pages · $0 forever
      </div>
    </footer>

    <script>
      import { initAuth } from '../scripts/auth';
      initAuth();
    </script>
    <script>
      // Scroll progress + reveal + header shadow.
      const progress = document.getElementById('scroll-progress');
      const onScroll = () => {
        const h = document.documentElement;
        const max = h.scrollHeight - h.clientHeight;
        if (progress) progress.style.width = (max > 0 ? (h.scrollTop / max) * 100 : 0) + '%';
        const header = document.querySelector('header');
        if (header) header.classList.toggle('border-[#26262b]', window.scrollY > 8);
      };
      addEventListener('scroll', onScroll, { passive: true });
      onScroll();

      const finePointer = window.matchMedia('(hover: hover) and (pointer: fine)').matches;
      const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

      let revealedByIO = false;
      const reveal = () => {
        const els = document.querySelectorAll('[data-reveal]:not(.is-visible)');
        if (!('IntersectionObserver' in window)) {
          els.forEach((el) => el.classList.add('is-visible'));
          return;
        }
        const io = new IntersectionObserver(
          (entries) => {
            for (const e of entries) {
              if (e.isIntersecting) {
                revealedByIO = true;
                const el = e.target as HTMLElement;
                const d = Number(el.dataset.revealDelay || 0);
                if (d) setTimeout(() => el.classList.add('is-visible'), d);
                else el.classList.add('is-visible');
                io.unobserve(el);
              }
            }
          },
          { threshold: 0.1, rootMargin: '0px 0px -50px 0px' }
        );
        els.forEach((el) => io.observe(el));
      };
      const startReveal = () => {
        if (document.readyState === 'loading') document.addEventListener('DOMContentLoaded', reveal);
        else reveal();
      };
      document.addEventListener('pf:reveal', reveal);

      // Boot: close the preloader, then start the entrance animations.
      const boot = () => {
        if (document.body.classList.contains('loaded')) return;
        document.body.classList.add('loaded');
        const pre = document.getElementById('preloader');
        if (pre) {
          pre.classList.add('done');
          setTimeout(() => pre.remove(), 700);
        }
        startReveal();
        // Safety net: if IntersectionObserver never revealed anything within 3s
        // (broken/missing), reveal everything so no content stays hidden. When IO
        // works it reveals the first above-fold element immediately, so this guard
        // leaves below-fold scroll reveals intact.
        setTimeout(() => {
          if (revealedByIO) return;
          document.querySelectorAll('[data-reveal]:not(.is-visible)').forEach((el) => el.classList.add('is-visible'));
        }, 3000);
      };
      const PT_KEY = 'pf.transition';
      const transitioning = sessionStorage.getItem(PT_KEY) === '1';
      if (transitioning) sessionStorage.removeItem(PT_KEY);
      const ptOverlay = document.getElementById('page-transition');

      if (transitioning && ptOverlay) {
        // Arriving after an in-site navigation: skip the preloader and reveal via
        // the transition overlay (logo → fade out → entrance).
        const pre = document.getElementById('preloader');
        if (pre) pre.remove();
        ptOverlay.classList.add('revealing');
        setTimeout(() => {
          ptOverlay.classList.add('closing');
          boot();
          setTimeout(() => ptOverlay.remove(), 700);
        }, 800);
      } else {
        if (reduceMotion) boot();
        else setTimeout(boot, 950);
        setTimeout(boot, 4000); // hard fallback if the timed boot is interrupted
      }

      // Page-transition departure: circle expands from the click point, then navigate.
      if (ptOverlay && !reduceMotion) {
        document.addEventListener('click', (e) => {
          const a = (e.target as HTMLElement).closest?.('a');
          if (!a) return;
          if (e.defaultPrevented || e.button !== 0 || e.metaKey || e.ctrlKey || e.shiftKey || e.altKey) return;
          if (a.target === '_blank') return;
          const raw = a.getAttribute('href') || '';
          if (!raw || raw.startsWith('#')) return;
          try {
            if (new URL(a.href).origin !== location.origin) return;
          } catch {
            return;
          }
          e.preventDefault();
          const r = a.getBoundingClientRect();
          const cx = r.left + r.width / 2;
          const cy = r.top + r.height / 2;
          ptOverlay.style.setProperty('--ptx', cx + 'px');
          ptOverlay.style.setProperty('--pty', cy + 'px');
          ptOverlay.classList.add('expanding');
          setTimeout(() => {
            sessionStorage.setItem(PT_KEY, '1');
            location.href = a.href;
          }, 660);
        });
      }

      // Cursor spotlight + magnetic buttons (fine-pointer, non-reduced-motion).
      const glow = document.getElementById('cursor-glow');
      if (glow && finePointer && !reduceMotion) {
        document.body.classList.add('cursor-active');
        let tx = window.innerWidth / 2, ty = window.innerHeight * 0.4;
        let x = tx, y = ty;
        addEventListener('pointermove', (e) => { tx = e.clientX; ty = e.clientY; }, { passive: true });
        const follow = () => {
          x += (tx - x) * 0.12;
          y += (ty - y) * 0.12;
          glow.style.setProperty('--mx', x + 'px');
          glow.style.setProperty('--my', y + 'px');
          requestAnimationFrame(follow);
        };
        requestAnimationFrame(follow);
      }
      if (finePointer && !reduceMotion) {
        const magnetize = (btn: HTMLElement) => {
          btn.classList.add('magnetic');
          btn.addEventListener('pointermove', (e) => {
            const r = btn.getBoundingClientRect();
            const dx = e.clientX - (r.left + r.width / 2);
            const dy = e.clientY - (r.top + r.height / 2);
            btn.style.transform = `translate(${(dx * 0.2).toFixed(1)}px, ${(dy * 0.35).toFixed(1)}px)`;
          });
          btn.addEventListener('pointerleave', () => { btn.style.transform = ''; });
        };
        document.querySelectorAll<HTMLElement>('.btn-primary, .btn-ghost').forEach((b) => magnetize(b));
      }

      // Lenis-style inertial smooth scroll (vanilla, no dependency). Wheel-only
      // glide; scrollbar drag, keyboard and anchor links stay native.
      if (finePointer && !reduceMotion) {
        const doc = document.documentElement;
        const maxScroll = () => Math.max(0, doc.scrollHeight - window.innerHeight);
        let target = window.scrollY;
        let current = window.scrollY;
        let raf = 0;
        let running = false;

        const tick = () => {
          current += (target - current) * 0.085;
          if (Math.abs(target - current) < 0.5) current = target;
          window.scrollTo({ top: current, behavior: 'instant' as ScrollBehavior });
          if (Math.abs(target - current) > 0.5) {
            raf = requestAnimationFrame(tick);
          } else {
            running = false;
            raf = 0;
          }
        };

        const glide = (delta: number) => {
          target = Math.max(0, Math.min(maxScroll(), target + delta));
          if (!running) {
            running = true;
            raf = requestAnimationFrame(tick);
          }
        };

        const inScrollable = (el: Element | null): boolean => {
          for (let n = el; n && n !== document.body; n = n.parentElement) {
            const s = getComputedStyle(n);
            const scrollsY = /(auto|scroll|overlay)/.test(s.overflowY) && n.scrollHeight > n.clientHeight;
            const scrollsX = /(auto|scroll|overlay)/.test(s.overflowX) && n.scrollWidth > n.clientWidth;
            if (scrollsY || scrollsX) return true;
          }
          return false;
        };

        addEventListener('wheel', (e) => {
          if (e.ctrlKey || e.metaKey) return; // keep pinch-to-zoom
          if (inScrollable(e.target as Element)) return; // let native sub-scrolls work
          e.preventDefault();
          glide(e.deltaY);
        }, { passive: false });

        addEventListener('scroll', () => {
          if (!running) { current = target = window.scrollY; }
        }, { passive: true });
      }

      // Nav sliding indicator (glides between active + hovered links).
      const navEl = document.getElementById('main-nav');
      const navIndicator = document.getElementById('nav-indicator');
      if (navEl && navIndicator) {
        const navLinks = Array.from(navEl.querySelectorAll<HTMLElement>('a'));
        const setTo = (link: HTMLElement) => {
          navIndicator.style.width = link.offsetWidth + 'px';
          navIndicator.style.transform = `translateX(${link.offsetLeft}px)`;
        };
        const activeLink = navLinks.find((l) => l.getAttribute('aria-current') === 'page') || navLinks[0];
        if (activeLink) setTo(activeLink);
        navLinks.forEach((l) => l.addEventListener('pointerenter', () => setTo(l)));
        navEl.addEventListener('pointerleave', () => { if (activeLink) setTo(activeLink); });
        addEventListener('resize', () => { if (activeLink) setTo(activeLink); });
        if (document.fonts && document.fonts.ready) {
          document.fonts.ready.then(() => { if (activeLink) setTo(activeLink); });
        }
      }
    </script>
  </body>
</html>
