---
import Layout from '../layouts/Layout.astro';
const base = import.meta.env.BASE_URL;
---

<Layout title="Page not found" description="404 — this page does not exist.">
  <section class="mx-auto max-w-2xl px-4 sm:px-6 py-24 text-center">
    <div class="text-7xl font-extrabold silver-text">404</div>
    <h1 class="text-2xl font-bold text-zinc-100 mt-4">That page doesn't exist</h1>
    <p class="text-zinc-400 mt-2">The prompt you're looking for may have been merged, renamed, or never existed.</p>
    <a href={`${base}`} class="btn-primary px-6 py-3 mt-8">โ Back to browsing</a>
  </section>
</Layout>
