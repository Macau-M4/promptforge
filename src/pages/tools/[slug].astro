---
import Layout from '../../layouts/Layout.astro';
import { getCollection, render } from 'astro:content';

export async function getStaticPaths() {
  const tools = await getCollection('tool');
  return tools.map((t) => ({ params: { slug: t.id }, props: { tool: t } }));
}

const { tool } = Astro.props;
const { Content } = await render(tool);
const base = import.meta.env.BASE_URL;
---

<Layout title={tool.data.title} description={tool.data.description}>
  <article class="mx-auto max-w-3xl px-4 sm:px-6 py-10">
    <nav class="text-sm text-slate-500 mb-6">
      <a href={`${base}tools`} class="hover:text-slate-300">Tools</a>
      <span class="mx-1">/</span>
      <span>{tool.data.title}</span>
    </nav>

    <header class="mb-6">
      <div class="flex items-center gap-2 mb-3">
        <span class="chip bg-emerald-500/10 border border-emerald-500/30 text-emerald-200">100% free</span>
        {tool.data.url && <a href={tool.data.url} target="_blank" rel="noopener" class="chip bg-white/5 border border-white/10 text-slate-300 hover:bg-white/10">Visit ↗</a>}
      </div>
      <h1 class="text-3xl font-bold text-slate-100 leading-tight">{tool.data.title}</h1>
      <p class="text-slate-400 mt-2">{tool.data.description}</p>
    </header>

    <div class="prose-pf panel p-6">
      <Content />
    </div>
  </article>
</Layout>
