---
import Layout from '../../layouts/Layout.astro';
import { getCollection } from 'astro:content';

const tools = await getCollection('tool');
const base = import.meta.env.BASE_URL;

const kindLabel = {
  'free-api': { label: 'Free API', emoji: '🔌' },
  local: { label: 'Local', emoji: '🖥️' },
  platform: { label: 'Platform', emoji: '🧩' },
  utility: { label: 'Utility', emoji: '🛠️' }
} as const;
---

<Layout title="Tools" description="Free, open-source LLM providers and tools you can use with PromptForge.">
  <section class="mx-auto max-w-5xl px-4 sm:px-6 py-12">
    <h1 class="text-4xl font-extrabold tracking-tight">Free <span class="grad-text">tools & providers</span></h1>
    <p class="mt-3 text-lg text-slate-400 max-w-2xl">
      Every backend PromptForge works with is free — no credit card, no trial that converts.
      Pick one to learn how to get a key (or skip the key entirely).
    </p>

    <div class="mt-10 grid gap-5 sm:grid-cols-2">
      {tools.map((t) => {
        const k = kindLabel[t.data.kind] ?? kindLabel.utility;
        return (
          <a href={`${base}tools/${t.id}`} class="panel card-lift p-5 group">
            <div class="flex items-center gap-2 mb-2">
              <span class="chip bg-white/5 border border-white/10 text-slate-300">{k.emoji} {k.label}</span>
              <span class="chip bg-emerald-500/10 border border-emerald-500/30 text-emerald-200">free</span>
            </div>
            <h2 class="text-xl font-bold text-slate-100 group-hover:text-indigo-200">{t.data.title}</h2>
            <p class="text-sm text-slate-400 mt-2">{t.data.description}</p>
            <div class="mt-3 text-sm font-semibold text-indigo-300 group-hover:text-indigo-200">Read more →</div>
          </a>
        );
      })}
    </div>
  </section>
</Layout>
