---
import Layout from '../../layouts/Layout.astro';
import { getCollection } from 'astro:content';

const tools = await getCollection('tool');
const base = import.meta.env.BASE_URL;

const kindLabel = {
  'free-api': { label: 'Free API' },
  local: { label: 'Local' },
  platform: { label: 'Platform' },
  utility: { label: 'Utility' }
} as const;
---

<Layout title="Tools" description="Free, open-source LLM providers and tools you can use with PromptForge.">
  <section class="mx-auto max-w-5xl px-4 sm:px-6 py-12">
    <h1 class="text-4xl font-extrabold tracking-tight">Free <span class="silver-text">tools & providers</span></h1>
    <p class="mt-3 text-lg text-zinc-400 max-w-2xl">
      ทุก backend ที่ PromptForge รองรับใช้งานฟรี — ไม่ต้องใช้บัตรเครดิต เลือกดูวิธีขอ key หรือข้ามไปเลยก็ได้
    </p>

    <div class="mt-10 grid gap-5 sm:grid-cols-2">
      {tools.map((t) => {
        const k = kindLabel[t.data.kind] ?? kindLabel.utility;
        return (
          <a href={`${base}tools/${t.id}`} class="panel card-lift p-5 group">
            <div class="flex items-center gap-2 mb-2">
              <span class="chip bg-white/5 border border-white/10 text-zinc-300">{k.label}</span>
              <span class="chip bg-zinc-500/10 border border-zinc-500/30 text-zinc-200">free</span>
            </div>
            <h2 class="text-xl font-bold text-zinc-100 group-hover:text-zinc-200">{t.data.title}</h2>
            <p class="text-sm text-zinc-400 mt-2">{t.data.description}</p>
            <div class="mt-3 text-sm font-semibold text-zinc-300 group-hover:text-zinc-200">Read more →</div>
          </a>
        );
      })}
    </div>
  </section>
</Layout>
