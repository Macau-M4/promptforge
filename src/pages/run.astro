---
import Layout from '../layouts/Layout.astro';
import { getCollection } from 'astro:content';
import { extractPromptBlock } from '../lib/markdown';

const prompts = await getCollection('prompt');
const data = prompts.map((p) => ({
  id: p.id,
  title: p.data.title,
  category: p.data.category,
  prompt: extractPromptBlock(p.body || '')
}));
---

<Layout
  title="Run a prompt"
  description="Execute any prompt against a free LLM (Pollinations keyless, Gemini, Groq or OpenRouter) directly in your browser."
>
  <section class="mx-auto max-w-6xl px-4 sm:px-6 py-12">
    <h1 class="text-4xl font-extrabold tracking-tight">Run a prompt <span class="silver-text">in-page</span></h1>
    <p class="mt-3 text-lg text-zinc-400 max-w-3xl">
      เลือก Prompt เติมค่าใน <code class="bg-white/10 px-1.5 py-0.5 rounded text-zinc-200 font-mono text-sm">{"{{variables}}"}</code>
      แล้วกดรัน — <strong class="text-zinc-200">Pollinations ไม่ต้องใช้ key</strong> ใช้งานได้ทันทีฟรี
      ส่วน provider อื่นใส่ free key ที่นี่ได้ (เก็บไว้ใน localStorage ของเบราว์เซอร์เท่านั้น)
    </p>

    <div class="mt-6 panel p-4 text-sm text-zinc-400 flex flex-wrap gap-x-6 gap-y-2">
      <span>ไม่ต้องสมัครบัญชี</span>
      <span>Key เก็บไว้ในเบราว์เซอร์เท่านั้น</span>
      <span>$0 — ไม่ต้องใช้บัตรเครดิต</span>
    </div>

    <div id="run-app" class="mt-8"></div>
  </section>

  <script type="application/json" id="run-data" set:html={JSON.stringify(data)}></script>
  <script>
    import { initRun } from '../scripts/run';
    initRun();
  </script>
</Layout>
