---
import Layout from '../layouts/Layout.astro';
import { getCollection } from 'astro:content';
import { extractPromptBlock } from '../lib/markdown';

const prompts = await getCollection('prompt');
const paths = await getCollection('path');
const tools = await getCollection('tool');

const data = prompts.map((p) => ({
  id: p.id,
  title: p.data.title,
  description: p.data.description,
  category: p.data.category,
  tags: p.data.tags,
  difficulty: p.data.difficulty,
  model: p.data.model,
  author: p.data.author,
  created: p.data.created,
  updated: p.data.updated,
  upvotes: p.data.upvotes,
  downvotes: p.data.downvotes,
  prompt: extractPromptBlock(p.body || '')
}));

const totalVotes = data.reduce((s, p) => s + (p.upvotes - p.downvotes), 0);
const catCount = new Set(data.map((p) => p.category)).size;
const base = import.meta.env.BASE_URL;
---

<Layout>
  <!-- HERO -->
  <section id="hero" class="relative min-h-[92vh] flex items-center overflow-hidden">
    <div class="hero-beam" aria-hidden="true"></div>
    <div class="aurora-blob aurora-a w-[70vw] h-[70vw] max-w-[760px] max-h-[760px] -top-[25%] -left-[20%] bg-zinc-300/30" aria-hidden="true"></div>
    <div class="aurora-blob aurora-b w-[60vw] h-[60vw] max-w-[640px] max-h-[640px] top-[28%] -right-[18%] bg-zinc-500/25" aria-hidden="true"></div>
    <div class="float-shape float-ring w-[30vw] h-[30vw] max-w-[380px] max-h-[380px] top-[6%] right-[9%]" aria-hidden="true"></div>
    <div class="float-shape float-square w-[17vw] h-[17vw] max-w-[220px] max-h-[220px] bottom-[9%] left-[6%]" aria-hidden="true"></div>
    <canvas id="hero-canvas" class="absolute inset-0 w-full h-full" aria-hidden="true"></canvas>
    <div class="light-sweep" aria-hidden="true"></div>
    <div class="relative z-10 mx-auto max-w-6xl px-5 sm:px-6 w-full py-24">
      <p class="mono-label mb-7" data-reveal>Creative developer library — free, forever</p>
      <h1 class="display text-[clamp(2.9rem,11vw,8.5rem)] text-zinc-100 leading-[0.9]">
        <span class="kinetic-line"><span style="animation-delay:.05s">Prompts,</span></span>
        <span class="kinetic-line"><span style="animation-delay:.18s"><span class="silver-text">Forged.</span></span></span>
      </h1>
      <p class="mt-8 font-display text-xl sm:text-2xl text-zinc-100" data-reveal data-reveal-delay="320">Discover. Remix. Create.</p>
      <p class="mt-3 text-base sm:text-lg text-zinc-400 max-w-lg leading-relaxed" data-reveal data-reveal-delay="380">
        คลัง Prompt, คำสั่ง และ Workflow แบบ open-source — ค้นหา โหวต และรันได้ทันทีในเบราว์เซอร์
      </p>
      <div class="mt-10 flex flex-wrap gap-4" data-reveal data-reveal-delay="460">
        <a href="#browse" class="btn-primary">Explore Prompts</a>
        <a href={`${base}run`} class="btn-ghost">Enter Playground</a>
      </div>
      <div class="mt-20 flex items-center gap-4" data-reveal data-reveal-delay="560">
        <span class="inline-block w-px h-12 bg-zinc-700"></span>
        <span class="mono-label">Scroll to explore</span>
      </div>
    </div>
  </section>

  <!-- STATS / COMMAND CENTER -->
  <section class="border-y border-[#1c1c20]">
    <div class="mx-auto max-w-6xl">
      <div class="flex items-center gap-3 px-5 sm:px-6 pt-7" data-reveal>
        <span class="status-dot"></span>
        <span class="mono-label text-zinc-400">All systems operational · $0/mo hosting · 100% open source</span>
      </div>
      <div class="grid grid-cols-2 sm:grid-cols-4 mt-6">
        <div class="py-10 px-6 border-r border-b sm:border-b-0 border-[#1c1c20]" data-reveal>
          <div class="display text-4xl sm:text-5xl text-zinc-100" data-count={data.length}>{data.length}</div>
          <div class="mono-label mt-2">Prompts</div>
        </div>
        <div class="py-10 px-6 border-r border-b sm:border-b-0 border-[#1c1c20]" data-reveal data-reveal-delay="80">
          <div class="display text-4xl sm:text-5xl text-zinc-100" data-count={catCount}>{catCount}</div>
          <div class="mono-label mt-2">Categories</div>
        </div>
        <div class="py-10 px-6 border-r border-b sm:border-b-0 border-[#1c1c20]" data-reveal data-reveal-delay="160">
          <div class="display text-4xl sm:text-5xl text-zinc-100" data-count={paths.length}>{paths.length}</div>
          <div class="mono-label mt-2">Learning paths</div>
        </div>
        <div class="py-10 px-6" data-reveal data-reveal-delay="240">
          <div class="display text-4xl sm:text-5xl text-zinc-100" data-count={totalVotes}>{totalVotes}</div>
          <div class="mono-label mt-2">Net votes</div>
        </div>
      </div>
      <div class="px-5 sm:px-6 pb-8 mt-6">
        <div class="terminal max-w-2xl" data-reveal>
          <div class="terminal-line text-zinc-500">~/promptforge $ status</div>
          <div id="terminal-lines" aria-live="polite"></div>
        </div>
      </div>
    </div>
  </section>

  <!-- HOW IT WORKS (scroll-triggered stepper) -->
  <section id="how" class="mx-auto max-w-6xl px-5 sm:px-6 py-24 scroll-mt-16">
    <div class="mb-12" data-reveal>
      <p class="mono-label mb-3">How PromptForge works</p>
      <h2 class="display text-3xl sm:text-5xl text-zinc-100">Forge in 4 steps</h2>
    </div>
    <div class="grid gap-5 md:grid-cols-2 lg:grid-cols-4">
      <div class="border-beam glass rounded-lg p-6" data-reveal>
        <div class="mono-label text-zinc-500 mb-3">Step 01</div>
        <h3 class="text-lg font-semibold text-zinc-100">Browse &amp; Search</h3>
        <p class="text-sm text-zinc-400 mt-2">ค้นหา กรอง และโหวต Prompt คุณภาพสูงที่ผ่านการรับรอง</p>
      </div>
      <div class="border-beam glass rounded-lg p-6" data-reveal data-reveal-delay="90">
        <div class="mono-label text-zinc-500 mb-3">Step 02</div>
        <h3 class="text-lg font-semibold text-zinc-100">Interactive Paths</h3>
        <p class="text-sm text-zinc-400 mt-2">เดินตามเส้นทางการเรียนรู้แบบเป็นขั้นตอน จากเริ่มต้นถึงขั้นสูง</p>
      </div>
      <div class="border-beam glass rounded-lg p-6" data-reveal data-reveal-delay="180">
        <div class="mono-label text-zinc-500 mb-3">Step 03</div>
        <h3 class="text-lg font-semibold text-zinc-100">Run in Playground</h3>
        <p class="text-sm text-zinc-400 mt-2">ทดสอบรันและปรับ Parameter ในเบราว์เซอร์ได้ทันที ไม่ต้องใช้ key</p>
      </div>
      <div class="border-beam glass rounded-lg p-6" data-reveal data-reveal-delay="270">
        <div class="mono-label text-zinc-500 mb-3">Step 04</div>
        <h3 class="text-lg font-semibold text-zinc-100">Contribute via PR</h3>
        <p class="text-sm text-zinc-400 mt-2">แชร์ Prompt ใหม่ ๆ เข้าสู่คลังผ่าน GitHub pull request</p>
      </div>
    </div>
  </section>

  <!-- BROWSE -->
  <section id="browse" class="mx-auto max-w-6xl px-5 sm:px-6 py-24 scroll-mt-16">
    <div class="flex items-end justify-between mb-10" data-reveal>
      <div>
        <p class="mono-label mb-3">01 — Browse</p>
        <h2 class="display text-3xl sm:text-5xl text-zinc-100">The Library</h2>
        <p class="mt-3 text-zinc-400 max-w-xl">ค้นหา กรอง และโหวต Prompt ที่ใช่ — หรือส่ง Prompt ของคุณเข้ามาร่วม</p>
      </div>
      <a href={`${base}contribute`} class="mono-label hover:text-zinc-200 transition-colors hidden sm:block">Submit ↗</a>
    </div>
    <div id="browser"></div>
  </section>

  <script type="application/json" id="prompts-data" set:html={JSON.stringify(data)}></script>
  <script>
    import { initBrowser } from '../scripts/browser';
    import { initHero } from '../scripts/hero';
    initBrowser();
    initHero();

    // Animated counters
    const animate = (el: HTMLElement) => {
      const target = Number(el.dataset.count || 0);
      const dur = 1200;
      const t0 = performance.now();
      const tick = (now: number) => {
        const p = Math.min((now - t0) / dur, 1);
        el.textContent = String(p >= 1 ? target : Math.round(target * (1 - Math.pow(1 - p, 3))));
        if (p < 1) requestAnimationFrame(tick);
      };
      if (window.matchMedia('(prefers-reduced-motion: reduce)').matches) el.textContent = String(target);
      else requestAnimationFrame(tick);
    };
    const counters = document.querySelectorAll<HTMLElement>('[data-count]');
    if ('IntersectionObserver' in window) {
      const io = new IntersectionObserver((es) => {
        for (const e of es) if (e.isIntersecting) { animate(e.target as HTMLElement); io.unobserve(e.target); }
      }, { threshold: 0.5 });
      counters.forEach((c) => io.observe(c));
    } else counters.forEach((c) => c.textContent = c.dataset.count || '0');

    // Terminal typewriter log
    const termEl = document.getElementById('terminal-lines');
    if (termEl) {
      const lines = [
        { pre: '[PROMPTFORGE-CLI] Loading prompt schema... ', ok: 'PASS' },
        { pre: '[LLM-ROUTER] Pollinations Keyless Gateway... ', ok: 'CONNECTED' },
        { pre: '[BUILD] Astro Static Engine... ', ok: '100% OPTIMIZED' },
        { pre: '[HOSTING] GitHub Pages CDN... ', ok: '$0/MONTH' }
      ];
      let started = false;
      const esc = (s: string) => s.replace(/[&<>]/g, (c) => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;' }[c] as string));
      const run = () => {
        if (started) return;
        started = true;
        let done = 0;
        let ci = 0;
        const render = () => {
          let html = '';
          for (let i = 0; i < done; i++) {
            html += `<div class="terminal-line"><span class="dim">${esc(lines[i].pre)}</span><span class="ok">${esc(lines[i].ok)}</span></div>`;
          }
          if (done < lines.length) {
            const l = lines[done];
            const full = l.pre + l.ok;
            const typed = full.slice(0, ci);
            const inOk = ci > l.pre.length;
            const prePart = inOk ? l.pre : typed;
            const okPart = inOk ? typed.slice(l.pre.length) : '';
            html += `<div class="terminal-line">${esc(prePart)}<span class="ok">${esc(okPart)}</span><span class="terminal-cursor"></span></div>`;
          } else {
            // Typing finished — keep a blinking cursor so the terminal never freezes.
            html += `<div class="terminal-line"><span class="dim">~/promptforge $ </span><span class="terminal-cursor"></span></div>`;
          }
          termEl.innerHTML = html;
        };
        const step = () => {
          const l = lines[done];
          const fullLen = l.pre.length + l.ok.length;
          ci++;
          render();
          if (ci >= fullLen) {
            done++;
            ci = 0;
            if (done >= lines.length) return;
            setTimeout(step, 220);
          } else {
            setTimeout(step, 12);
          }
        };
        step();
      };
      if ('IntersectionObserver' in window) {
        const io = new IntersectionObserver((es) => {
          if (es[0].isIntersecting) { run(); io.disconnect(); }
        }, { threshold: 0.3 });
        io.observe(termEl);
      } else {
        run();
      }
    }
  </script>
</Layout>
