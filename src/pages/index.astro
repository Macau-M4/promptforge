---
import Layout from '../layouts/Layout.astro';
import { getCollection } from 'astro:content';
import { extractPromptBlock } from '../lib/markdown';

const prompts = await getCollection('prompt');
const paths = await getCollection('path');
const tools = await getCollection('tool');

const data = prompts.map((p) => ({
  id: p.id,
  title: p.data.title,
  description: p.data.description,
  category: p.data.category,
  tags: p.data.tags,
  difficulty: p.data.difficulty,
  model: p.data.model,
  author: p.data.author,
  created: p.data.created,
  updated: p.data.updated,
  upvotes: p.data.upvotes,
  downvotes: p.data.downvotes,
  prompt: extractPromptBlock(p.body || '')
}));

const totalVotes = data.reduce((s, p) => s + (p.upvotes - p.downvotes), 0);
const catCount = new Set(data.map((p) => p.category)).size;
const base = import.meta.env.BASE_URL;
---

<Layout>
  <section class="mx-auto max-w-6xl px-4 sm:px-6 pt-14 pb-10 text-center">
    <span class="chip bg-indigo-500/10 border border-indigo-500/30 text-indigo-200 mb-4">100% free · open source · no card required</span>
    <h1 class="text-4xl sm:text-6xl font-extrabold tracking-tight leading-tight">
      The community library of<br class="hidden sm:block" />
      <span class="grad-text">AI prompts, commands & workflows</span>
    </h1>
    <p class="mx-auto mt-5 max-w-2xl text-lg text-slate-400">
      Browse battle-tested prompts, upvote the best, follow learning paths, and run any
      prompt against a free LLM — right in your browser. Contribute your own via GitHub.
    </p>
    <div class="mt-8 flex flex-wrap justify-center gap-3">
      <a href="#browser" class="btn-primary px-6 py-3 text-base">Browse prompts</a>
      <a href={`${base}paths`} class="btn-ghost px-6 py-3 text-base">Start learning</a>
      <a href={`${base}run`} class="btn-ghost px-6 py-3 text-base">▶ Run a prompt</a>
    </div>

    <div class="mt-12 grid grid-cols-2 sm:grid-cols-4 gap-3 max-w-3xl mx-auto">
      <div class="panel p-4">
        <div class="text-3xl font-bold grad-text">{data.length}</div>
        <div class="text-xs text-slate-400 mt-1">prompts</div>
      </div>
      <div class="panel p-4">
        <div class="text-3xl font-bold grad-text">{catCount}</div>
        <div class="text-xs text-slate-400 mt-1">categories</div>
      </div>
      <div class="panel p-4">
        <div class="text-3xl font-bold grad-text">{paths.length}</div>
        <div class="text-xs text-slate-400 mt-1">learning paths</div>
      </div>
      <div class="panel p-4">
        <div class="text-3xl font-bold grad-text">{totalVotes}</div>
        <div class="text-xs text-slate-400 mt-1">net votes</div>
      </div>
    </div>
  </section>

  <section id="browser" class="mx-auto max-w-6xl px-4 sm:px-6 pb-20 scroll-mt-20">
    <div id="browser"></div>
  </section>

  <script type="application/json" id="prompts-data" set:html={JSON.stringify(data)}></script>
  <script>
    import { initBrowser } from '../scripts/browser';
    initBrowser();
  </script>
</Layout>
