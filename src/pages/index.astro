---
import Layout from '../layouts/Layout.astro';
import { getCollection } from 'astro:content';
import { extractPromptBlock } from '../lib/markdown';

const prompts = await getCollection('prompt');
const paths = await getCollection('path');
const tools = await getCollection('tool');

const data = prompts.map((p) => ({
  id: p.id,
  title: p.data.title,
  description: p.data.description,
  category: p.data.category,
  tags: p.data.tags,
  difficulty: p.data.difficulty,
  model: p.data.model,
  author: p.data.author,
  created: p.data.created,
  updated: p.data.updated,
  upvotes: p.data.upvotes,
  downvotes: p.data.downvotes,
  prompt: extractPromptBlock(p.body || '')
}));

const totalVotes = data.reduce((s, p) => s + (p.upvotes - p.downvotes), 0);
const catCount = new Set(data.map((p) => p.category)).size;
const base = import.meta.env.BASE_URL;
---

<Layout>
  <!-- HERO -->
  <section id="hero" class="relative min-h-[92vh] flex items-center overflow-hidden">
    <div class="aurora-blob aurora-a w-[70vw] h-[70vw] max-w-[760px] max-h-[760px] -top-[25%] -left-[20%] bg-zinc-300/30" aria-hidden="true"></div>
    <div class="aurora-blob aurora-b w-[60vw] h-[60vw] max-w-[640px] max-h-[640px] top-[28%] -right-[18%] bg-zinc-500/25" aria-hidden="true"></div>
    <canvas id="hero-canvas" class="absolute inset-0 w-full h-full" aria-hidden="true"></canvas>
    <div class="light-sweep" aria-hidden="true"></div>
    <div class="relative z-10 mx-auto max-w-6xl px-5 sm:px-6 w-full py-24">
      <p class="mono-label mb-7" data-reveal>Creative developer library — free, forever</p>
      <h1 class="display text-[clamp(2.9rem,11vw,8.5rem)] text-zinc-100 leading-[0.9]">
        <span class="kinetic-line"><span style="animation-delay:.05s">Prompts,</span></span>
        <span class="kinetic-line"><span style="animation-delay:.18s"><span class="silver-text">Forged.</span></span></span>
      </h1>
      <p class="mt-8 font-display text-xl sm:text-2xl text-zinc-100" data-reveal data-reveal-delay="320">Discover. Remix. Create.</p>
      <p class="mt-3 text-base sm:text-lg text-zinc-400 max-w-lg leading-relaxed" data-reveal data-reveal-delay="380">
        คลัง Prompt, คำสั่ง และ Workflow แบบ open-source — ค้นหา โหวต และรันได้ทันทีในเบราว์เซอร์
      </p>
      <div class="mt-10 flex flex-wrap gap-4" data-reveal data-reveal-delay="460">
        <a href="#browse" class="btn-primary">Explore Prompts</a>
        <a href={`${base}run`} class="btn-ghost">Enter Playground</a>
      </div>
      <div class="mt-20 flex items-center gap-4" data-reveal data-reveal-delay="560">
        <span class="inline-block w-px h-12 bg-zinc-700"></span>
        <span class="mono-label">Scroll to explore</span>
      </div>
    </div>
  </section>

  <!-- STATS -->
  <section class="border-y border-[#1c1c20]">
    <div class="mx-auto max-w-6xl grid grid-cols-2 sm:grid-cols-4">
      <div class="py-10 px-6 border-r border-b sm:border-b-0 border-[#1c1c20]" data-reveal>
        <div class="display text-4xl sm:text-5xl text-zinc-100" data-count={data.length}>{data.length}</div>
        <div class="mono-label mt-2">Prompts</div>
      </div>
      <div class="py-10 px-6 border-r border-b sm:border-b-0 border-[#1c1c20]" data-reveal data-reveal-delay="80">
        <div class="display text-4xl sm:text-5xl text-zinc-100" data-count={catCount}>{catCount}</div>
        <div class="mono-label mt-2">Categories</div>
      </div>
      <div class="py-10 px-6 border-r border-b sm:border-b-0 border-[#1c1c20]" data-reveal data-reveal-delay="160">
        <div class="display text-4xl sm:text-5xl text-zinc-100" data-count={paths.length}>{paths.length}</div>
        <div class="mono-label mt-2">Learning paths</div>
      </div>
      <div class="py-10 px-6" data-reveal data-reveal-delay="240">
        <div class="display text-4xl sm:text-5xl text-zinc-100" data-count={totalVotes}>{totalVotes}</div>
        <div class="mono-label mt-2">Net votes</div>
      </div>
    </div>
  </section>

  <!-- BROWSE -->
  <section id="browse" class="mx-auto max-w-6xl px-5 sm:px-6 py-24 scroll-mt-16">
    <div class="flex items-end justify-between mb-10" data-reveal>
      <div>
        <p class="mono-label mb-3">01 — Browse</p>
        <h2 class="display text-3xl sm:text-5xl text-zinc-100">The Library</h2>
        <p class="mt-3 text-zinc-400 max-w-xl">ค้นหา กรอง และโหวต Prompt ที่ใช่ — หรือส่ง Prompt ของคุณเข้ามาร่วม</p>
      </div>
      <a href={`${base}contribute`} class="mono-label hover:text-zinc-200 transition-colors hidden sm:block">Submit ↗</a>
    </div>
    <div id="browser"></div>
  </section>

  <script type="application/json" id="prompts-data" set:html={JSON.stringify(data)}></script>
  <script>
    import { initBrowser } from '../scripts/browser';
    import { initHero } from '../scripts/hero';
    initBrowser();
    initHero();

    // Animated counters
    const animate = (el: HTMLElement) => {
      const target = Number(el.dataset.count || 0);
      const dur = 1200;
      const t0 = performance.now();
      const tick = (now: number) => {
        const p = Math.min((now - t0) / dur, 1);
        el.textContent = String(p >= 1 ? target : Math.round(target * (1 - Math.pow(1 - p, 3))));
        if (p < 1) requestAnimationFrame(tick);
      };
      if (window.matchMedia('(prefers-reduced-motion: reduce)').matches) el.textContent = String(target);
      else requestAnimationFrame(tick);
    };
    const counters = document.querySelectorAll<HTMLElement>('[data-count]');
    if ('IntersectionObserver' in window) {
      const io = new IntersectionObserver((es) => {
        for (const e of es) if (e.isIntersecting) { animate(e.target as HTMLElement); io.unobserve(e.target); }
      }, { threshold: 0.5 });
      counters.forEach((c) => io.observe(c));
    } else counters.forEach((c) => c.textContent = c.dataset.count || '0');
  </script>
</Layout>
