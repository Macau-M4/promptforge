---
import Layout from '../../layouts/Layout.astro';
import { getCollection, render } from 'astro:content';

export async function getStaticPaths() {
  const paths = await getCollection('path');
  return paths.map((p) => ({ params: { slug: p.id }, props: { path: p } }));
}

const { path } = Astro.props;
const { Content } = await render(path);
const prompts = await getCollection('prompt');
const promptById = new Map(prompts.map((p) => [p.id, p]));
const refs = path.data.prompts.map((id) => promptById.get(id)).filter(Boolean) as typeof prompts;
const base = import.meta.env.BASE_URL;

const levelMeta = {
  start: { label: 'Start here', color: 'bg-zinc-500/10 border-zinc-500/30 text-zinc-200' },
  advance: { label: 'Advance', color: 'bg-zinc-500/10 border-zinc-500/30 text-zinc-200' },
  master: { label: 'Master', color: 'bg-zinc-500/10 border-zinc-500/30 text-zinc-200' }
} as const;
const lm = levelMeta[path.data.level];
---

<Layout title={path.data.title} description={path.data.description}>
  <article class="mx-auto max-w-3xl px-4 sm:px-6 py-10">
    <nav class="text-sm text-zinc-500 mb-6">
      <a href={`${base}paths`} class="hover:text-zinc-300">Learning paths</a>
      <span class="mx-1">/</span>
      <span>{path.data.title}</span>
    </nav>

    <header class="mb-6">
      <span class={`chip border ${lm.color}`}>{lm.label}</span>
      <h1 class="text-3xl font-bold text-zinc-100 mt-3 leading-tight">{path.data.title}</h1>
      <p class="text-zinc-400 mt-2">{path.data.description}</p>
    </header>

    <div class="prose-pf panel p-6">
      <Content />
    </div>

    <section class="mt-10">
      <h2 class="text-xl font-bold text-zinc-100 mb-4">Prompts in this track</h2>
      <ol class="space-y-3">
        {refs.map((p, i) => (
          <li>
            <a href={`${base}prompts/${p.id}`} class="panel p-4 flex items-center gap-4 hover:border-zinc-500/40 transition-colors group">
              <span class="text-2xl font-bold text-zinc-600 group-hover:text-zinc-400 w-8 text-center">{i + 1}</span>
              <div class="flex-1 min-w-0">
                <div class="font-semibold text-zinc-100 group-hover:text-zinc-200">{p.data.title}</div>
                <div class="text-sm text-zinc-400 truncate">{p.data.description}</div>
              </div>
              <span class="text-zinc-500 group-hover:text-zinc-300">→</span>
            </a>
          </li>
        ))}
      </ol>
    </section>
  </article>
</Layout>
