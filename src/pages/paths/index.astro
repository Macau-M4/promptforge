---
import Layout from '../../layouts/Layout.astro';
import { getCollection } from 'astro:content';

const paths = await getCollection('path');
const prompts = await getCollection('prompt');
const promptById = new Map(prompts.map((p) => [p.id, p]));

const ordered = paths.sort((a, b) => a.data.order - b.data.order);
const levelMeta = {
  start: { label: 'Start here', color: 'bg-zinc-500/10 border-zinc-500/30 text-zinc-200' },
  advance: { label: 'Advance', color: 'bg-zinc-500/10 border-zinc-500/30 text-zinc-200' },
  master: { label: 'Master', color: 'bg-zinc-500/10 border-zinc-500/30 text-zinc-200' }
} as const;
const base = import.meta.env.BASE_URL;
---

<Layout title="Learning paths" description="Guided tracks that take you from your first prompt to orchestrating full AI workflows.">
  <section class="mx-auto max-w-5xl px-4 sm:px-6 py-12">
    <h1 class="text-4xl font-extrabold tracking-tight">Learning <span class="silver-text">paths</span></h1>
    <p class="mt-3 text-lg text-zinc-400 max-w-2xl">
      สามเส้นทางที่จัดเรียง Prompt ตามลำดับ — เริ่มจากพื้นฐานจนถึงการ orchestrate งานจริงด้วย AI
    </p>

    <div class="mt-10 space-y-6">
      {ordered.map((path) => {
        const lm = levelMeta[path.data.level];
        const refs = path.data.prompts
          .map((id) => promptById.get(id))
          .filter(Boolean) as typeof prompts;
        return (
          <div class="panel card-lift p-6" data-reveal>
            <div class="flex items-center gap-3 mb-2">
              <span class={`chip border ${lm.color}`}>{lm.label}</span>
              <span class="text-xs text-zinc-500">Track {path.data.order} of {ordered.length}</span>
            </div>
            <h2 class="text-2xl font-bold text-zinc-100">
              <a href={`${base}paths/${path.id}`} class="hover:text-zinc-300">{path.data.title}</a>
            </h2>
            <p class="text-zinc-400 mt-2">{path.data.description}</p>
            <div class="mt-4 flex flex-wrap gap-2">
              {refs.map((p) => (
                <a href={`${base}prompts/${p.id}`} class="chip bg-white/5 border border-white/10 text-zinc-300 hover:bg-white/10 hover:text-white">
                  {p.data.title}
                </a>
              ))}
            </div>
            <a href={`${base}paths/${path.id}`} class="inline-block mt-4 text-sm font-semibold text-zinc-300 hover:text-zinc-200">
              Start this path →
            </a>
          </div>
        );
      })}
    </div>
  </section>
</Layout>
